rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is the owner
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function to validate image size (max 10MB)
    function isValidImageSize() {
      return request.resource == null || request.resource.size < 10 * 1024 * 1024;
    }
    
    // Helper function to validate image type
    function isValidImageType() {
      return request.resource == null || 
             request.resource.contentType == null || 
             request.resource.contentType.matches('image/.*') || 
             request.resource.contentType == 'application/octet-stream';
    }
    
    // User avatars - only owner can upload/delete, anyone authenticated can read
    match /user-avatars/{userId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && 
                      isOwner(userId) && 
                      isValidImageSize() && 
                      isValidImageType();
      allow delete: if isAuthenticated() && isOwner(userId);
    }
    
    // Chat images - secure path with userId isolation
    match /chat-images/{activityId}/{userId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && 
                      request.auth.uid == userId && 
                      isValidImageSize() && 
                      isValidImageType();
      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }

    // Legacy chat images (backward compatibility)
    match /chat-images/{activityId}/{fileName} {
      allow read, write: if isAuthenticated();
    }
    
    // Group avatars - authenticated users can upload/update
    match /group-avatars/{groupId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && 
                      isValidImageSize() && 
                      isValidImageType();
      allow delete: if isAuthenticated();
    }
    
    // Catch-all fallback for authenticated uploads
    match /{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isValidImageSize();
    }
  }
}
