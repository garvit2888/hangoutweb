rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is the owner
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function to check if user is a member of an activity
    // Uses the new memberIds array for simpler/cheaper check
    function isActivityMember(activityId) {
      let activityData = get(/databases/$(database)/documents/activities/$(activityId)).data;
      return isAuthenticated() && 
             (
               (activityData.memberIds != null && activityData.memberIds.hasAny([request.auth.uid])) ||
               (activityData.members != null && activityData.members is list && activityData.members.hasAny(['id'], [request.auth.uid])) // Fallback
             );
    }
    
    // User profiles - only owner can write, anyone authenticated can read
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isOwner(userId);
    }
    
    // User chats - only owner can read/write their own chats
    match /userChats/{userId} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow write: if isAuthenticated() && isOwner(userId);
    }
    
    // Activities - authenticated users can create/read
    // Updates are restricted to creator OR members joining/leaving
    match /activities/{activityId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && 
                       request.resource.data.createdBy == request.auth.uid;
                       
      // Allow update if:
      // 1. User is the creator (full access)
      // 2. User is joining/leaving (only modifying members/memberIds)
      allow update: if isAuthenticated() && (
        resource.data.createdBy == request.auth.uid ||
        (
           // Ensure critical fields are NOT changed by non-owners
           request.resource.data.createdBy == resource.data.createdBy &&
           request.resource.data.name == resource.data.name &&
           request.resource.data.id == resource.data.id &&
           // Only allow modifying members lists
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberIds', 'updatedAt'])
        )
      );
      
      allow delete: if isAuthenticated() && 
                       resource.data.createdBy == request.auth.uid;
      
      // Chat messages - only activity members can access
      match /messages/{messageId} {
        allow read: if isAuthenticated() && isActivityMember(activityId);
        allow create: if isAuthenticated() && 
                         request.resource.data.senderId == request.auth.uid &&
                         isActivityMember(activityId);
        allow update: if false; // Messages cannot be edited
        allow delete: if isAuthenticated() && 
                         resource.data.senderId == request.auth.uid;
      }
    }
    
    // Reports (for future use)
    match /reports/{reportId} {
      allow read: if false; // Only admins can read (implement admin check)
      allow create: if isAuthenticated();
    }
    
    // Typing status - ephemeral
    match /typing_status/{statusId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && 
                      request.resource.data.userId == request.auth.uid;
    }
  }
}

